generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model IncidentLog {
  id         String   @id @default(uuid())
  shipmentId String
  raisedById String
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  phoneNumber  String @unique
  passwordHash String
  firstName    String
  lastName     String
  emailVerificationToken String?   @unique
  role             UserRole          @default(CUSTOMER)
  status           IdentityStatus    @default(PENDING_VERIFICATION)
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payments         Payment[]
  businessProfile  BusinessProfile?
  notifications    Notification[]
  reviewsGiven     Review[]          @relation("CustomerReviews")
  riderProfile     RiderProfile?
  savedAddresses   SavedAddress[]
  shipmentsSent    Shipment[]        @relation("CustomerShipments")
  wallet           Wallet?
  pushSubscriptions PushSubscription[]
  routeWaitlists RouteWaitlist[]
  organizerProfile      EventOrganizerProfile?
eventBookings         EventBooking[]          @relation("CustomerEventBookings")
eventPayments         EventPayment[]          @relation("CustomerEventPayments")
  @@map("users")
}

model SavedAddress {
  id         String      @id @default(uuid())
  userId     String
  label      String
  type       AddressType @default(HOME)
  street     String
  city       String
  state      String
  country    String      @default("Nigeria")
  postalCode String?
  latitude   Float
  longitude  Float
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_addresses")
}

model RiderProfile {
  id                 String  @id @default(uuid())
  userId             String  @unique
  nin                String? @unique
  driversLicense     String? @unique
  isOnline           Boolean @default(false)
  ratingAverage      Float   @default(5.0)
  currentHubId       String?
  bankName           String?
  transactionPinHash String?
  bankCode           String?
  eventTrips            EventTrip[]             @relation("EventTripDriver")
  accountNumber String?

  accountName         String?
  activeVehicleId     String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  completedDeliveries Int               @default(0)
  trustScore          Int               @default(100)
  reviewsReceived     Review[]          @relation("RiderReviews")
  assignments         RiderAssignment[]
  activeVehicle       Vehicle?          @relation("ActiveVehicle", fields: [activeVehicleId], references: [id])
  currentHub          TransitHub?       @relation(fields: [currentHubId], references: [id])
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments           Shipment[]        @relation("RiderShipments")
  ownedVehicles       Vehicle[]         @relation("VehicleOwner")
  withdrawals         Withdrawal[]

  @@index([currentHubId])
  @@map("rider_profiles")
}

model RiderApplication {
  id                    String                 @id @default(uuid())
  userId                String?                @unique
  currentStep           Int                    @default(1)
  status                RiderApplicationStatus @default(DRAFT)

  firstName             String?
  lastName              String?
  email                 String?
  phoneNumber           String?
  middleName            String?
  referralCode          String?

  dateOfBirth           DateTime?
  gender                Gender?
  residentialAddress    String?
  state                 String?
  city                  String?
  localGovernment       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?

  idType                IdType?
  idNumber              String?
  idFrontUrl            String?
  idBackUrl             String?
  selfieUrl             String?

  vehicleType           VehicleType?
  plateNumber           String?
  vehicleBrand          String?
  vehicleModel          String?
  vehicleColor          String?
  vehicleYear           Int?
  vehiclePhotoUrl       String?

  driversLicenseUrl     String?
  vehiclePaperUrl       String?
  insuranceUrl          String?
  roadWorthinessUrl     String?
  profilePhotoUrl       String?

  bankName              String?
  bankCode              String?
  accountNumber         String?
  accountName           String?

  acceptedTerms         Boolean                @default(false)
  acceptedCommission    Boolean                @default(false)
  acceptedDeliveryPolicy Boolean               @default(false)

  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedBy            String?
  rejectionReason       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}
enum RiderApplicationStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum IdType {
  NIN
  DRIVERS_LICENSE
  VOTERS_CARD
  INTERNATIONAL_PASSPORT
}

model Vehicle {
  id              String        @id @default(uuid())
  ownerId         String
  type            VehicleType   @default(MOTORCYCLE)
  make            String
  model           String
  year            Int?
  plateNumber     String        @unique
  color           String?
  insuranceExpiry DateTime?
  isVerified      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activeRider     RiderProfile? @relation("ActiveVehicle")
  owner           RiderProfile  @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  eventTrips            EventTrip[]
  @@map("vehicles")
}

model BusinessProfile {
  id                  String     @id @default(uuid())
  userId              String     @unique
  businessName        String     @unique
  registrationNumber  String?    @unique
  logoUrl             String?
  website             String?
  marketplaceStoreId  String?    @unique
  isMarketplaceVendor Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments           Shipment[] @relation("BusinessShipments")

  @@map("business_profiles")
}

model TransitHub {
  id           String         @id @default(uuid())
  name         String         @unique
  street       String
  city         String
  state        String
  latitude     Float
  longitude    Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  riders       RiderProfile[]
  hubShipments Shipment[]     @relation("HubLocation")

  @@map("transit_hubs")
}
model Shipment {
  id           String @id @default(uuid())
  trackingCode String @unique

  status ShipmentStatus @default(PENDING)
  tier   DeliveryTier   @default(STANDARD)

  // Customer
  customerId String
  customer   User   @relation("CustomerShipments", fields: [customerId], references: [id])

  // Sender Metadata
  senderName  String?
  senderPhone String?

  // Pickup Metadata
  pickupAddress  String
  pickupLandmark String?
  pickupLat      Float
  pickupLng      Float
  pickupPlaceId  String?

  // Destination Metadata
  destinationAddress  String
  destinationLandmark String?
  destinationLat      Float
  destinationLng      Float
  destinationPlaceId String?

  riderLastLat String?
  riderLastLng String?

  // Delivery
  deliveryType    DeliveryType
  packageCategory PackageCategory
  weightRange     WeightRange
  regionType      RegionType

  description     String?
  recipient       String
  recipientPhone  String
  verificationPin String

  isExpress      Boolean @default(false)
  isFragile      Boolean @default(false)
  waterproof     Boolean @default(false)
  keepUpright    Boolean @default(false)
  handleWithCare Boolean @default(false)

  isSmartDelivery     Boolean  @default(false)
  smartDeliveryPhotos String[]

  specialNotes String?

  // Pricing
  baseFee         Decimal @db.Decimal(10, 2)
  pickupDistFee   Decimal @db.Decimal(10, 2)
  deliveryDistFee Decimal @db.Decimal(10, 2)
  extraCharges    Decimal @db.Decimal(10, 2)

  totalPrice    Decimal @db.Decimal(10, 2)
  riderShare    Decimal @db.Decimal(10, 2)
  platformShare Decimal @db.Decimal(10, 2)

  distanceKm       Float
  estimatedMinutes Int

  // Optional business fields
  businessId         String?
  riderId            String?
  currentHubId       String?
  promoCodeId        String?
  marketplaceOrderId String?   @unique
  escrowReleaseAt    DateTime?
  deliveredAt        DateTime? // 👈 ADDED HERE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   BusinessProfile? @relation("BusinessShipments", fields: [businessId], references: [id])
  rider      RiderProfile?    @relation("RiderShipments", fields: [riderId], references: [id])
  currentHub TransitHub?      @relation("HubLocation", fields: [currentHubId], references: [id])
  promoCode  PromoCode?       @relation(fields: [promoCodeId], references: [id])
  paymentStatus PaymentStatus  @default(PENDING)
  payments        Payment[]
  reviews         Review[]
  assignments     RiderAssignment[]
  timelineEvents StatusTimeline[]
  trackingLogs    TrackingLog[]

  @@index([status])
  @@index([customerId])
  @@index([riderId])
  @@map("shipments")
}

model Landmark {
  id          String   @id @default(uuid())
  state       String   @default("Osun")
  city        String   @default("Osogbo")
  name        String   // e.g., "Old Garage"
  aliases     String[] // e.g., ["old garage", "station road", "garage"]
  description String?  // e.g., "Opposite GTBank / Station Road Roundabout"
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([city])
  @@index([isActive])
  @@map("landmarks")
}



model RiderAssignment {
  id         String           @id @default(uuid())
  shipmentId String
  riderId    String
  status     AssignmentStatus @default(OFFERED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  rider      RiderProfile     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  shipment   Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([riderId])
  @@map("rider_assignments")
}

model TrackingLog {
  id         String   @id @default(uuid())
  shipmentId String
  latitude   Float
  longitude  Float
  bearing    Float?
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt(sort: Desc)])
  @@map("tracking_logs")
}

model StatusTimeline {
  id          String         @id @default(uuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  changedBy   String
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("status_timelines")
}

model Wallet {
  id               String        @id @default(uuid())
  userId           String        @unique
  availableBalance Decimal       @default(0) @db.Decimal(12, 2)
  pendingBalance   Decimal       @default(0) @db.Decimal(12, 2)
  currency         String        @default("NGN")
  updatedAt        DateTime      @updatedAt
  withdrawals      Withdrawal[]
  transactions     Transaction[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id            String          @id @default(uuid())
  walletId      String
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  category      LedgerCategory
  referenceCode String          @unique
  description   String
  createdAt     DateTime        @default(now())
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  WithdrawalId  String?

  @@index([walletId])
  @@map("transactions")
}

model PromoCode {
  id           String     @id @default(uuid())
  code         String     @unique
  discount     Decimal    @db.Decimal(10, 2)
  isPercentage Boolean    @default(false)
  expiryDate   DateTime
  usageLimit   Int        @default(100)
  usedCount    Int        @default(0)
  isActive     Boolean    @default(true)
  shipments    Shipment[]

  @@map("promo_codes")
}


model GlobalConfig {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "BIKE_BASE_FEE", "PLATFORM_COMMISSION_PCT"
  value       String   // Text-encoded value to support dynamic strings, floats, or numbers safely
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("global_configs")
}

model BroadcastLog {
  id             String    @id @default(uuid())
  targetAudience UserRole? // If null, broadcasts to all platforms and applications globally
  title          String
  body           String    @db.Text
  channel        ChannelType @default(IN_APP)
  sentById       String
  createdAt      DateTime  @default(now())

  @@index([targetAudience])
  @@map("broadcast_logs")
}

model Review {
  id         String       @id @default(uuid())
  shipmentId String
  reviewerId String
  riderId    String
  rating     Int
  comment    String?
  createdAt  DateTime     @default(now())
  reviewer   User         @relation("CustomerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  rider      RiderProfile @relation("RiderReviews", fields: [riderId], references: [id], onDelete: Cascade)
  shipment   Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@map("reviews")
}

model Notification {
  id        String      @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String?     // e.g. "LOGIN_ALERT", "ESCROW_VERIFICATION_PIN", "ORDER_STATUS_UPDATE"
  channel   ChannelType @default(IN_APP)
  isRead    Boolean     @default(false)
  data      Json?       // Metadata (e.g., { pin: "8492", orderId: "..." })
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(uuid())
  creatorId   String
  subject     String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

model Payment {
  id              String        @id @default(cuid())
  shipmentId      String
  customerId      String
  gateway         String
  txRef           String        @unique
  flutterwaveTxId String?
  flutterwaveRef  String?
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        User          @relation(fields: [customerId], references: [id])
  shipment        Shipment      @relation(fields: [shipmentId], references: [id])
}

model Withdrawal {
  id String @id @default(cuid())

  walletId String

  riderId String

  amount Decimal @db.Decimal(12, 2)

  bankName      String
  bankCode      String
  accountNumber String
  accountName   String

  flutterwaveReference String?
  flutterwaveId        String?

  rejectionReason String?

  approvedBy String?
  approvedAt DateTime?

  completedAt DateTime?

  status WithdrawalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])

  rider RiderProfile @relation(fields: [riderId], references: [id])
}

enum PackageCategory {
  SMALL_PARCEL
  MEDIUM_PARCEL
  LARGE_PARCEL
  FRAGILE_ITEM
  CLOTHING
  ELECTRONICS
}

enum WeightRange {
  UNDER_1KG
  FROM_1_3KG
  FROM_3_5KG
  FROM_5_10KG
  FROM_10_20KG
  ABOVE_20KG
}

enum RegionType {
  INTRA_CITY
  INTRA_STATE
  INTERSTATE
}

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  RIDER
  ADMIN
  SUPER_ADMIN
  ORGANIZER
}

enum IdentityStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
  TRICYCLE
  BUS
}

enum AddressType {
  HOME
  OFFICE
  WAREHOUSE
  PICKUP_POINT
}

enum ShipmentStatus {
  AWAITING_PAYMENT
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  DISPUTED
}

enum DisputeRole {
  CUSTOMER
  RIDER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ResolutionOutcome {
  REFUND_CUSTOMER
  CREDIT_RIDER
  PARTIAL_REFUND
  NO_ACTION
}

model ChatMessage {
  id          String      @id @default(uuid())
  jobId       String
  senderId    String
  senderRole  SenderRole
  text        String
  messageType MessageType @default(TEXT)
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([jobId])
}

model CallLog {
  id          String     @id @default(uuid())
  jobId       String
  callerId    String
  receiverId  String
  status      CallStatus @default(MISSED)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  duration    Int?       @default(0) // Duration in seconds

  @@index([jobId])
}

enum SenderRole {
  CUSTOMER
  RIDER
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  SYSTEM
}

enum CallStatus {
  MISSED
  DECLINED
  COMPLETED
  FAILED
}

model Dispute {
  id              String             @id @default(uuid())
  jobId           String
  reporterId      String             // User ID of the customer or rider opening the dispute
  reportedByRole  DisputeRole
  reason          String
  description     String
  status          DisputeStatus      @default(OPEN)
  resolution      ResolutionOutcome?
  adminNotes      String?            @db.Text
  resolvedById    String?            // Admin user ID who resolved it
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  logs            DisputeLog[]

  @@index([jobId])
  @@index([reporterId])
  @@index([status])
}

model DisputeLog {
  id        String   @id @default(uuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actorId   String
  action    String   // e.g., "STATUS_UPDATED", "NOTE_ADDED", "RESOLVED"
  note      String?
  createdAt DateTime @default(now())

  @@index([disputeId])
}

enum DeliveryTier {
  STANDARD
  EXPRESS
  SAME_DAY
  INTERSTATE
}

enum DeliverySpeed {
  STANDARD
  EXPRESS
}

enum DeliveryType {
  PARCEL
  FOOD
  GROCERY
  PHARMACY
  DOCUMENT
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  TIMED_OUT
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REJECTED
}

enum LedgerCategory {
  DELIVERY_PAYMENT
  RIDER_EARNINGS
  PLATFORM_COMMISSION
  WALLET_TOPUP
  WITHDRAWAL
  INSURANCE_PREMIUM
  PROMO_DISCOUNT
  CASH_COLLECTION_REMITTANCE
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ChannelType {
  IN_APP
  PUSH
  SMS
  EMAIL
}


// ==========================================
// AVIORÈGO EVENTS & TRANSPORT EXTENSION
// ==========================================

model EventOrganizerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  organizationName String
  supportEmail     String?
  supportPhone     String?
  logoUrl          String?
  isVerified       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@map("event_organizer_profiles")
}

model Event {
  id          String      @id @default(uuid())
  organizerId String
  title       String
  description String      @db.Text
  venue       String
  city        String
  state       String
  startDate   DateTime
  endDate     DateTime
  bannerUrl   String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizer EventOrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  routes    EventRoute[]
  bookings  EventBooking[]

  @@index([organizerId])
  @@index([status])
  @@map("events")
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ONGOING
  COMPLETED
  CANVASSED
  CANCELLED
}
model EventRoute {
  id             String   @id @default(uuid())
  eventId        String
  originCity     String
  destination    String
  
  // NEW: Exact map coordinates for the route's destination/venue
  destinationLat Float?
  destinationLng Float?

  price          Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pickupPoints PickupPoint[]
  trips        EventTrip[]
  bookings     EventBooking[]
  waitlist     RouteWaitlist[]

  @@index([eventId])
  @@map("event_routes")
}

model PickupPoint {
  id          String   @id @default(uuid())
  routeId     String
  name        String   // e.g., "Ikeja City Mall"
  address     String
  landmark    String?
  maxCapacity Int      @default(40)
  
  // NEW: Exact GPS coordinates for the pickup point pin on the map
  latitude    Float?
  longitude   Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  route    EventRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookings EventBooking[]

  @@index([routeId])
  @@map("pickup_points")
}

model EventTrip {
  id            String      @id @default(uuid())
  routeId       String
  vehicleId     String?
  driverId      String?     // Links to RiderProfile id
  tripLeg       TripLeg     @default(OUTBOUND)
  departureTime DateTime
  arrivalTime   DateTime?
  status        TripStatus  @default(SCHEDULED)
  
  // CONTROL FLAG: Controls when the trip becomes visible/bookable by attendees & organizers
  isPublished   Boolean     @default(false) 

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  route    EventRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver   RiderProfile? @relation("EventTripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  bookings EventBooking[]

  @@index([routeId])
  @@index([driverId])
  @@index([isPublished])
  @@map("event_trips")
}

enum TripLeg {
  OUTBOUND
  RETURN
}

enum TripStatus {
  SCHEDULED
  BOARDING
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

model EventBooking {
  id             String         @id @default(uuid())
  eventId        String
  customerId     String         // Links to User id
  routeId        String
  pickupPointId  String
  tripId         String
  qrToken        String         @unique @default(uuid())
  paymentStatus  PaymentStatus  @default(PENDING)
  boardingStatus BoardingStatus @default(NOT_CHECKED_IN)
  amountPaid     Decimal        @db.Decimal(10, 2)
  checkedInAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer    User          @relation("CustomerEventBookings", fields: [customerId], references: [id], onDelete: Cascade)
  route       EventRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupPoint PickupPoint   @relation(fields: [pickupPointId], references: [id], onDelete: Cascade)
  trip        EventTrip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payments    EventPayment[]

  @@index([customerId])
  @@index([eventId])
  @@index([tripId])
  @@map("event_bookings")
}

enum BoardingStatus {
  NOT_CHECKED_IN
  CHECKED_IN
  BOARDED
  NO_SHOW
  COMPLETED
}

model RouteWaitlist {
  id        String   @id @default(uuid())
  routeId   String
  userId    String
  createdAt DateTime @default(now())

  route EventRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routeId, userId])
  @@index([routeId])
  @@index([userId])
  @@map("route_waitlists")
}

model EventPayment {
  id              String        @id @default(cuid())
  bookingId       String
  customerId      String
  gateway         String
  txRef           String        @unique
  flutterwaveTxId String?
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking  EventBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User         @relation("CustomerEventPayments", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("event_payments")
}